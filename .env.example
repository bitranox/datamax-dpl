# Copy to .env and fill values as needed.

# Codecov upload token (required for private repos; optional for public repos)
CODECOV_TOKEN=

# PyPI API token for the release workflow (.github/workflows/default_release_public.yml).
# Leave it empty when PyPI has a Trusted Publisher for this repo: the workflow then
# publishes via OIDC instead of the token.
# Format: pypi-AgENdGVzdC5weXBpLm9yZwIk...
PYPI_API_TOKEN=

# Optional: GitHub token for API-limited tasks
GITHUB_TOKEN=


# ==============================================================================
# Printer Configuration ([printer])
# ==============================================================================
#
# Naming Convention
# -----------------
# Format: <SECTION>__<KEY>=value (double underscore separates section from key)
# An unquoted value is converted (in .env and in the environment alike): true/false become
# booleans, null/none become None (except for secret keys such as passwords, which keep the
# text), a JSON array or object is parsed, and a number becomes a number only when it converts
# back to the same text (007 and 1.50 stay text). Quote a .env value to keep it as text; the
# quotes are removed.
#
# Full environment variable (outside .env):
#   DATAMAX_DPL___PRINTER__<KEY>=value
#   (triple underscore separates the application slug from the section)
# Command-line flags (--model, --printer, --policy ...) win over these values.

# Purpose: Printer model profile ('datamax-dpl models' lists them)
# PRINTER__MODEL=dmx-600

# Purpose: Printer firmware "<major>.<minor>"; empty assumes the oldest the manual covers.
#          An unquoted 2.01 arrives as a number and is read back as its text, the same version.
# PRINTER__FIRMWARE="2.01"

# Purpose: Where jobs go: tcp://HOST:PORT, serial:///dev/ttyS0?baud=9600, device:///dev/usb/lp0,
#          file:PATH or - (stdout)
# PRINTER__URI=tcp://192.0.2.60:9100

# Purpose: degrade (apply fallbacks, report them) or strict (refuse the label)
# PRINTER__POLICY=degrade

# Purpose: Seconds for one transport operation
# PRINTER__TIMEOUT=10.0

# Purpose: Seconds status and memory keep trying for the first answer (--timeout replaces it), and
#          the pause between two connections within it (and within stored_names_wait)
# PRINTER__STATUS_WAIT=30.0
# PRINTER__ANSWER_RETRY_INTERVAL=0.25

# Purpose: Seconds print keeps trying for each read of the printer's stored image names (<STX>W)
# PRINTER__STORED_NAMES_WAIT=30.0

# Purpose: Seconds of silence that end a <STX>W directory answer, and the longest one memory
#          answer may take (must be longer than directory_idle)
# PRINTER__DIRECTORY_IDLE=1.0
# PRINTER__DIRECTORY_READ_LIMIT=120.0

# Purpose: Rounds of print's upload check on a two-way link, 0 to 3 (0 reads nothing back)
# PRINTER__UPLOAD_CHECK_ROUNDS=3

# Purpose: Largest piece of a job handed to one write over tcp or serial, at most 65536 bytes
# PRINTER__SEND_CHUNK_BYTES=1024

# Purpose: Largest label or data file any command reads, in bytes; a larger one is refused
# PRINTER__MAX_INPUT_BYTES=16777216

# Purpose: Seconds one tcp opening retries a refused connect (never longer than timeout), and the
#          pause before each retry
# PRINTER__REFUSED_CONNECT_WAIT=3.0
# PRINTER__REFUSED_CONNECT_RETRY_INTERVAL=0.25

# Purpose: Bytes per second the link behind a tcp print server carries (960 = 9600 baud 8N1; 0 = no
#          wait), and the seconds added, before a tcp close: a print server feeding a serial printer
#          can lose the next connection's data while it still passes the last job on
# PRINTER__LINK_BYTES_PER_SECOND=960.0
# PRINTER__LINK_DRAIN_MARGIN=0.25

# Most records one --data batch may hold; more is refused before rendering. A bound on time, not memory.
# PRINTER__MAX_BATCH_RECORDS=100000

# Most bytes the jobs of one --data batch of render with no -o may come to; past it the command stops.
# PRINTER__MAX_BATCH_JOB_BYTES=67108864

# How many findings and image names a --data batch's answer keeps in full; it counts all of them.
# PRINTER__MAX_REPORTED_FINDINGS=1000
# PRINTER__MAX_REPORTED_DOWNLOADS=1000

# Purpose: Whether print asks for a reset report (<SOH>A) before a job on a two-way link
# PRINTER__RESET_CHECK=true

# Purpose: Seconds print waits for the one status read before a job; its answer reports a reset
# PRINTER__RESET_CHECK_WAIT=3.0

# Purpose: On a reported reset, print one calibration label before the job; false only reports it
# PRINTER__CALIBRATE_AFTER_RESET=true

# Purpose: What the calibration label says
# PRINTER__CALIBRATION_LABEL_TEXT="Printer Reset - Calibration Feed"

# Purpose: Cutter installed and enabled: yes, no or unknown
# PRINTER__CUTTER=unknown

# Purpose: Installed hardware options, as a JSON array
# PRINTER__OPTIONS=["datamatrix"]

# The keys below ship unset: unset takes the model's default (or, for the label settings, sends
# nothing). Set one to null to unset it again over a lower layer.

# Purpose: Printed over nominal length across the web and along the feed, 0.5 to 1.5
#          (calibrate set writes them)
# PRINTER__SCALE_ACROSS=1.0
# PRINTER__SCALE_ALONG=0.977

# Purpose: Millimetres every field moves right (across) and toward the label top (along), -10 to 10
# PRINTER__OFFSET_ACROSS=0.0
# PRINTER__OFFSET_ALONG=-0.25

# Purpose: Stop positions in mm, sent unscaled as <STX>f, at most 253.746: the tear-off stop (or
#          "printer" to send none), the stop of a job that cuts, and the stop of a record of a
#          --data series that cuts, which the next record follows uncut
# PRINTER__STOP_POSITION=66.8
# PRINTER__CUTTER_STOP_POSITION=80
# PRINTER__JOINED_STOP_POSITION=25.4

# Purpose: Cut a label without its own "cut" after every N labels, 1 to 9999
# PRINTER__CUT_EVERY=3

# Purpose: With cutter yes on a model whose job sets the cutter, cut after the last label of every print
# PRINTER__CUT_AFTER_PRINT=true

# Purpose: Bytes of image dot data one job may download (the model's budget when unset)
# PRINTER__IMAGE_MEMORY_BYTES=40000

# Purpose: Memory module images are downloaded to, A to E (the model's built-in RAM when unset)
# PRINTER__IMAGE_MODULE=A

# Purpose: Severity of a label's findings where no clear precedes its downloads: info, warning or error
# PRINTER__HELD_IMAGE_SEVERITY=warning

# Purpose: Highest dot row one format may reach (the model's limit when unset: 1648 on the Allegro 2)
# PRINTER__MAX_FORMAT_ROWS=1648

# Purpose: Whole printhead dots one 1/100 in prints as (the model's when unset: 2 on the Allegro 2)
# PRINTER__INCH_UNIT_DOTS=2

# Purpose: Most points one polygon of a label may have, at most 10000 (ships set to 60)
# PRINTER__MAX_POLYGON_POINTS=60

# Purpose: Clear the image module before each label's downloads; false keeps what the printer stores
# PRINTER__CLEAR_GRAPHICS_BEFORE=true

# Purpose: Clear the image module again after each label
# PRINTER__CLEAR_GRAPHICS_AFTER=true

# Purpose: Which printer settings each job sends, as a JSON array; unset sends every one
# PRINTER__SEND_SETTINGS=["media", "stop", "start_of_print", "max_label_length", "feed_rate", "software_switches"]

# Purpose: Media sensor a job sets when the label names none: gap, reflective or continuous; unset sets none
# PRINTER__MEDIA=gap

# Purpose: Start of print in mm (12.7 to 2539.746), sent as <STX>O; unset takes the model's default
# PRINTER__START_OF_PRINT_MM=55.88

# Purpose: How far the printer searches for a label edge, in mm (127 to 2539.746); unset takes the model's
# PRINTER__MAX_LABEL_LENGTH_MM=304.8

# Purpose: Feed button speed letter, A (1 in/s) to S (10 in/s); unset takes the model's slew default
# PRINTER__FEED_RATE=C

# Purpose: Label-present sensor on: yes, no or unknown; with cutter it builds the software switches (<STX>V)
# PRINTER__LABEL_PRESENT=unknown

# Purpose: Label settings for every label that sets none of its own; unset sends nothing, so the
#          printer keeps its own: heat 0 to 30, speed letters A (1 in/s) to S (10 in/s), and
#          column offset, row offset and present distance in mm
# PRINTER__HEAT=12
# PRINTER__PRINT_SPEED=C
# PRINTER__SLEW_SPEED=C
# PRINTER__BACKUP_SPEED=C
# PRINTER__COLUMN_OFFSET=2.5
# PRINTER__ROW_OFFSET=2.5
# PRINTER__PRESENT_DISTANCE=10

# Purpose: Width and height of the loaded labels in mm, for calibrate print and calibrate set
# PRINTER__LABEL_WIDTH=100
# PRINTER__LABEL_HEIGHT=55

# Named printers ([printers.<name>], chosen with --printer NAME) take the same keys:
# PRINTERS__LAGER__MODEL=allegro-2
# PRINTERS__LAGER__URI=tcp://192.0.2.60:9100

# ==============================================================================
# Preview Configuration ([preview])
# ==============================================================================

# Purpose: Longest side of a preview picture in mm, above 0, at most 100000
# PREVIEW__MAX_LENGTH_MM=2000.0

# ==============================================================================
# Logging Configuration (lib_log_rich)
# ==============================================================================
#
# Naming Convention
# -----------------
# Format: <SECTION>__<KEY>=value (double underscore separates section from key)
# Strings need no quotes. An unquoted value is converted: true/false become booleans,
# null/none become None, a JSON array or object is parsed, and a number becomes a number only
# when it converts back to the same text; quote a value to keep it as text. A table is a JSON object, written unquoted
# (LIB_LOG_RICH__CONSOLE_STYLES={"ERROR":"bold red"}), or one key per entry
# (LIB_LOG_RICH__SCRUB_PATTERNS__API_KEY=.+). Comma-separated pairs are NOT a table: they
# arrive as ONE string and are refused.
#
# Full environment variable (outside .env):
#   DATAMAX_DPL___LIB_LOG_RICH__<KEY>=value
#
# For nested subsections (e.g. payload_limits):
#   DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__<KEY>=value
#   .env: LIB_LOG_RICH__PAYLOAD_LIMITS__<KEY>=value

# --- Core Identity ---

# Purpose: Logical service name recorded in each log event
# Type: string (non-empty)
# Default: "datamax_dpl"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__SERVICE=my-application
# .env: LIB_LOG_RICH__SERVICE=my-application
# LIB_LOG_RICH__SERVICE=my-application

# Purpose: Deployment environment label
# Type: string (non-empty)
# Default: "prod"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__ENVIRONMENT=dev
# .env: LIB_LOG_RICH__ENVIRONMENT=dev
# LIB_LOG_RICH__ENVIRONMENT=dev

# --- Console Output ---

# Purpose: Minimum severity level emitted to Rich console
# Type: string (case-insensitive): "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Default: "INFO"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__CONSOLE_LEVEL=DEBUG
# .env: LIB_LOG_RICH__CONSOLE_LEVEL=DEBUG
# LIB_LOG_RICH__CONSOLE_LEVEL=DEBUG

# Purpose: Where to send console output
# Type: string: "stdout", "stderr", "both", "custom", "none"
# Default: "stderr"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__CONSOLE_STREAM=stderr
# .env: LIB_LOG_RICH__CONSOLE_STREAM=stderr
# LIB_LOG_RICH__CONSOLE_STREAM=stderr

# Purpose: Console line layout preset
# Type: string (case-insensitive): "full", "short", "full_loc", "short_loc", "short_loc_icon"
# Default: "short_loc"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__CONSOLE_FORMAT_PRESET=short_loc
# .env: LIB_LOG_RICH__CONSOLE_FORMAT_PRESET=short_loc
# LIB_LOG_RICH__CONSOLE_FORMAT_PRESET=short_loc

# Purpose: Custom console output template (overrides preset)
# Type: string (Python str.format template); empty = uses preset
# Default: (empty, uses preset)
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__CONSOLE_FORMAT_TEMPLATE={timestamp_trimmed_naive_loc} {level_code} {message}
# .env: LIB_LOG_RICH__CONSOLE_FORMAT_TEMPLATE={timestamp_trimmed_naive_loc} {level_code} {message}
# LIB_LOG_RICH__CONSOLE_FORMAT_TEMPLATE={timestamp_trimmed_naive_loc} {level_code} {message}

# Purpose: Rich color palette for console output
# Type: string: "classic", "dark", "neon", "pastel"
# Default: "dark"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__CONSOLE_THEME=dark
# .env: LIB_LOG_RICH__CONSOLE_THEME=dark
# LIB_LOG_RICH__CONSOLE_THEME=dark

# Purpose: Override Rich styles per severity level
# Type: table of LEVEL = style (a JSON object keeps the level names upper case)
# Default: (empty, uses theme defaults)
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__CONSOLE_STYLES='{"DEBUG":"dim","ERROR":"bold red"}'
# .env: LIB_LOG_RICH__CONSOLE_STYLES={"DEBUG":"dim","ERROR":"bold red"}
# LIB_LOG_RICH__CONSOLE_STYLES={"DEBUG":"dim","ERROR":"bold red"}

# Purpose: Force ANSI color output even when stderr is not a TTY
# Type: boolean (true/false)
# Default: false
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__FORCE_COLOR=true
# .env: LIB_LOG_RICH__FORCE_COLOR=true
# LIB_LOG_RICH__FORCE_COLOR=true

# Purpose: Disable color output entirely (overrides force_color)
# Type: boolean (true/false)
# Default: false
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__NO_COLOR=false
# .env: LIB_LOG_RICH__NO_COLOR=false
# LIB_LOG_RICH__NO_COLOR=false

# --- Backend Adapters ---

# Purpose: Minimum severity threshold for journald and Windows Event Log
# Type: string (case-insensitive): "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Default: "WARNING"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__BACKEND_LEVEL=WARNING
# .env: LIB_LOG_RICH__BACKEND_LEVEL=WARNING
# LIB_LOG_RICH__BACKEND_LEVEL=WARNING

# Purpose: Enable systemd journald adapter (Linux only; requires python3-systemd)
# Type: boolean (true/false)
# Default: false
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__ENABLE_JOURNALD=true
# .env: LIB_LOG_RICH__ENABLE_JOURNALD=true
# LIB_LOG_RICH__ENABLE_JOURNALD=true

# Purpose: Enable Windows Event Log adapter (Windows only)
# Type: boolean (true/false)
# Default: false
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__ENABLE_EVENTLOG=false
# .env: LIB_LOG_RICH__ENABLE_EVENTLOG=false
# LIB_LOG_RICH__ENABLE_EVENTLOG=false

# --- Graylog / GELF ---

# Purpose: Enable Graylog adapter for centralized logging
# Type: boolean (true/false)
# Default: false
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__ENABLE_GRAYLOG=true
# .env: LIB_LOG_RICH__ENABLE_GRAYLOG=true
# LIB_LOG_RICH__ENABLE_GRAYLOG=true

# Purpose: Graylog server address
# Type: JSON array [host, port]; a "host:port" string is refused: the commands that read
#   the configuration exit 78 naming lib_log_rich.graylog_endpoint (only the native
#   LOG_GRAYLOG_ENDPOINT variable takes host:port)
# Default: (none, must be configured to enable Graylog)
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__GRAYLOG_ENDPOINT='["graylog.example.com",12201]'
# .env: LIB_LOG_RICH__GRAYLOG_ENDPOINT=["graylog.example.com",12201]
# LIB_LOG_RICH__GRAYLOG_ENDPOINT=["graylog.example.com",12201]

# Purpose: Transport protocol for Graylog (tcp, udp); TLS only supported with tcp
# Type: string: "tcp", "udp"
# Default: "tcp"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__GRAYLOG_PROTOCOL=tcp
# .env: LIB_LOG_RICH__GRAYLOG_PROTOCOL=tcp
# LIB_LOG_RICH__GRAYLOG_PROTOCOL=tcp

# Purpose: Wrap Graylog TCP connection in TLS
# Type: boolean (true/false)
# Default: false
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__GRAYLOG_TLS=true
# .env: LIB_LOG_RICH__GRAYLOG_TLS=true
# LIB_LOG_RICH__GRAYLOG_TLS=true

# Purpose: Minimum severity level sent to Graylog
# Type: string (case-insensitive): "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
# Default: "WARNING"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__GRAYLOG_LEVEL=WARNING
# .env: LIB_LOG_RICH__GRAYLOG_LEVEL=WARNING
# LIB_LOG_RICH__GRAYLOG_LEVEL=WARNING

# --- Queue Settings ---

# Purpose: Route log events through background queue worker (false = synchronous, blocks on I/O)
# Type: boolean (true/false)
# Default: true
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__QUEUE_ENABLED=true
# .env: LIB_LOG_RICH__QUEUE_ENABLED=true
# LIB_LOG_RICH__QUEUE_ENABLED=true

# Purpose: Maximum pending events before queue full policy applies
# Type: integer (> 0)
# Default: 2048
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__QUEUE_MAXSIZE=2048
# .env: LIB_LOG_RICH__QUEUE_MAXSIZE=2048
# LIB_LOG_RICH__QUEUE_MAXSIZE=2048

# Purpose: Behavior when queue is full
# Type: string: "block" (wait for space), "drop" (discard events)
# Default: "block"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__QUEUE_FULL_POLICY=block
# .env: LIB_LOG_RICH__QUEUE_FULL_POLICY=block
# LIB_LOG_RICH__QUEUE_FULL_POLICY=block

# Purpose: Timeout in seconds for blocking queue puts (0 = infinite wait)
# Type: float (>= 0)
# Default: 1.0
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__QUEUE_PUT_TIMEOUT=1.0
# .env: LIB_LOG_RICH__QUEUE_PUT_TIMEOUT=1.0
# LIB_LOG_RICH__QUEUE_PUT_TIMEOUT=1.0

# Purpose: Maximum wait in seconds for queue drain during shutdown
# Type: float (> 0)
# Default: 5.0
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__QUEUE_STOP_TIMEOUT=5.0
# .env: LIB_LOG_RICH__QUEUE_STOP_TIMEOUT=5.0
# LIB_LOG_RICH__QUEUE_STOP_TIMEOUT=5.0

# --- Ring Buffer ---

# Purpose: Enable in-memory circular buffer for log history (enables log.dump())
# Type: boolean (true/false)
# Default: true
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__ENABLE_RING_BUFFER=true
# .env: LIB_LOG_RICH__ENABLE_RING_BUFFER=true
# LIB_LOG_RICH__ENABLE_RING_BUFFER=true

# Purpose: Maximum events retained in ring buffer
# Type: integer (> 0)
# Default: 25000
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__RING_BUFFER_SIZE=25000
# .env: LIB_LOG_RICH__RING_BUFFER_SIZE=25000
# LIB_LOG_RICH__RING_BUFFER_SIZE=25000

# Purpose: JSON-lines file the ring buffer loads at start and appends its events to when flushed
#          (shutdown, dump); a directory is refused. LOG_RING_BUFFER_CHECKPOINT wins over it.
# Type: string (file path); empty = no file
# Default: (none, no checkpoint file)
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__RING_BUFFER_CHECKPOINT=/path/to/ring.jsonl
# .env: LIB_LOG_RICH__RING_BUFFER_CHECKPOINT=/path/to/ring.jsonl
# LIB_LOG_RICH__RING_BUFFER_CHECKPOINT=/path/to/ring.jsonl

# --- Dump Format ---

# Purpose: Default layout for text dumps
# Type: string (case-insensitive): "full", "short", "full_loc", "short_loc"
# Default: "full"
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__DUMP_FORMAT_PRESET=full
# .env: LIB_LOG_RICH__DUMP_FORMAT_PRESET=full
# LIB_LOG_RICH__DUMP_FORMAT_PRESET=full

# Purpose: Custom template for text dumps (overrides preset)
# Type: string (Python str.format template); empty = uses preset
# Default: (empty, uses preset)
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__DUMP_FORMAT_TEMPLATE={timestamp_trimmed_naive_loc} {level_code} {message}
# .env: LIB_LOG_RICH__DUMP_FORMAT_TEMPLATE={timestamp_trimmed_naive_loc} {level_code} {message}
# LIB_LOG_RICH__DUMP_FORMAT_TEMPLATE={timestamp_trimmed_naive_loc} {level_code} {message}

# --- Security & Payload ---

# Purpose: Regex patterns to redact sensitive data (field = regex)
# Type: table of field = regex; merged with the defaults
# Default: password = .+, secret = .+, token = .+
# Environment Variable, one key per field: DATAMAX_DPL___LIB_LOG_RICH__SCRUB_PATTERNS__API_KEY=.+
# .env, one key per field: LIB_LOG_RICH__SCRUB_PATTERNS__API_KEY=.+
# LIB_LOG_RICH__SCRUB_PATTERNS__API_KEY=.+

# Purpose: Throttle log emissions (max_events per window_seconds)
# Type: JSON array [max_events, window_seconds]; a "100:60" string is refused: the commands
#   that read the configuration exit 78 naming lib_log_rich.rate_limit (only the native
#   LOG_RATE_LIMIT variable takes MAX:WINDOW_SECONDS)
# Default: (none, no rate limiting)
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__RATE_LIMIT='[100,60]'
# .env: LIB_LOG_RICH__RATE_LIMIT=[100,60]
# LIB_LOG_RICH__RATE_LIMIT=[100,60]

# --- Payload Limits ---

# Purpose: Truncate vs reject oversized messages
# Type: boolean (true/false)
# Default: true
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__TRUNCATE_MESSAGE=true
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__TRUNCATE_MESSAGE=true
# LIB_LOG_RICH__PAYLOAD_LIMITS__TRUNCATE_MESSAGE=true

# Purpose: Maximum characters in primary log message
# Type: integer
# Default: 4096
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__MESSAGE_MAX_CHARS=4096
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__MESSAGE_MAX_CHARS=4096
# LIB_LOG_RICH__PAYLOAD_LIMITS__MESSAGE_MAX_CHARS=4096

# Purpose: Maximum keys in extra metadata dict
# Type: integer
# Default: 25
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_KEYS=25
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_KEYS=25
# LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_KEYS=25

# Purpose: Maximum characters per extra value (after stringify)
# Type: integer
# Default: 512
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_VALUE_CHARS=512
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_VALUE_CHARS=512
# LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_VALUE_CHARS=512

# Purpose: Maximum nesting depth for extra structures
# Type: integer
# Default: 3
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_DEPTH=3
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_DEPTH=3
# LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_DEPTH=3

# Purpose: Total UTF-8 byte limit for sanitized extra payload
# Type: integer
# Default: 8192
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_TOTAL_BYTES=8192
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_TOTAL_BYTES=8192
# LIB_LOG_RICH__PAYLOAD_LIMITS__EXTRA_MAX_TOTAL_BYTES=8192

# Purpose: Maximum keys in LogContext.extra
# Type: integer
# Default: 20
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__CONTEXT_MAX_KEYS=20
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__CONTEXT_MAX_KEYS=20
# LIB_LOG_RICH__PAYLOAD_LIMITS__CONTEXT_MAX_KEYS=20

# Purpose: Maximum characters per context value
# Type: integer
# Default: 256
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__CONTEXT_MAX_VALUE_CHARS=256
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__CONTEXT_MAX_VALUE_CHARS=256
# LIB_LOG_RICH__PAYLOAD_LIMITS__CONTEXT_MAX_VALUE_CHARS=256

# Purpose: Number of frames preserved in exception tracebacks
# Type: integer
# Default: 10
# Environment Variable: DATAMAX_DPL___LIB_LOG_RICH__PAYLOAD_LIMITS__STACKTRACE_MAX_FRAMES=10
# .env: LIB_LOG_RICH__PAYLOAD_LIMITS__STACKTRACE_MAX_FRAMES=10
# LIB_LOG_RICH__PAYLOAD_LIMITS__STACKTRACE_MAX_FRAMES=10
